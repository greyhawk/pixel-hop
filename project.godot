config_version=5

[application]
config/name="Pixel Hop"
run/main_scene="res://scenes/main.tscn"

[autoload]
Game="*res://autoload/game.gd"
Transition="*res://autoload/transition.gd"
Audio="*res://autoload/audio.gd"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[layer_names]
2d_physics/layer_1="world_solid"
2d_physics/layer_2="world_oneway"
2d_physics/layer_3="player"
2d_physics/layer_4="enemy"
2d_physics/layer_5="pickup"
2d_physics/layer_6="hazard"

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=false

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=false
