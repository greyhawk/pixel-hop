const SIGN_TEXTS: Array = Strings.SIGN_TEXTS

## 地图字符表（§7.1）。
const LEGEND := ".#=^oESPFdh"


## §14: 校验关卡网格：12 行 × 40 列、仅图例字符、恰好一个 P 和一个 F。
static func validate(rows: Array) -> bool:
	if rows.size() != ROWS:
		return false
	for i in rows.size():
		var row: String = rows[i]
		if row.length() != COLS:
			return false
		for c in row.length():
			if not LEGEND.contains(row.substr(c, 1)):
				return false
	var p_count := 0
	var f_count := 0
	for i in rows.size():
		var row: String = rows[i]
		p_count += row.count("P")
		f_count += row.count("F")
	return p_count == 1 and f_count == 1
